# Production environment — copy to infra/.env before: make prod-build && make prod-up

# Strong secrets (required)
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32
SECRET_KEY=change-me-use-python-secrets-token-hex-32

# App
ENVIRONMENT=production

# Comma-separated browser origins allowed for CORS (your public URL)
ALLOWED_ORIGINS=https://your-domain.example.com

# Web build: leave empty for same-origin API via nginx reverse proxy
VITE_API_URL=

# Host port for nginx entrypoint
HTTP_PORT=80

# Grafana (served at http://<host>/grafana/)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_ROOT_URL=http://8.231.102.114/grafana/

# Optional feature flags
WALLET_ENABLED=false
