# Copy this file to .env and fill in the values

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret-in-production

# PostgreSQL (used by docker-compose)
# POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB are baked into docker-compose.yml for dev

# App environment
ENVIRONMENT=development

# Optional: restrict CORS origins in production (comma-separated)
# ALLOWED_ORIGINS=https://rakt.durg.gov.in
