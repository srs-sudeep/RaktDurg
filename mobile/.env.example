# Mobile API configuration (pass via --dart-define; Flutter does not load .env natively)
#
# Release APKs / IPAs default to http://8.231.102.114 (also set in CI).
# Debug builds default to the Android emulator loopback unless overridden.

# Android emulator → host machine
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000

# iOS simulator → host machine
# flutter run --dart-define=API_BASE_URL=http://127.0.0.1:8000

# Physical device → production
# flutter run --dart-define=API_BASE_URL=http://8.231.102.114

# Physical device → your Mac LAN IP (local API)
# flutter run --dart-define=API_BASE_URL=http://192.168.x.x:8000

API_BASE_URL=http://10.0.2.2:8000
